include README.md
include CHANGELOG.md
include uv.lock
include .github/build-constraints.txt
include .github/workflows/package.yml
include .github/workflows/release.yml
recursive-include configs *.yaml
recursive-include docs *.md
recursive-include examples *.py *.md
recursive-include tests *.py *.yaml *.jpg
recursive-include scripts *.py *.md
global-exclude *.local.yaml *.local.yml
global-exclude __pycache__ *.py[cod]
include LICENSE
recursive-include requirements *.txt
prune docs/releases
exclude docs/service/review.md docs/service/release-plan.md
